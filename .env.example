# Copy thành .env rồi điền key Groq (miễn phí tại https://console.groq.com/keys)
# Có nhiều key (khác tài khoản) thì phân cách bằng dấu phẩy: key bị giới hạn sẽ tự chuyển sang key kế tiếp
LLM_API_KEY=
# Tùy chọn: endpoint chuẩn OpenAI khác (OpenRouter, Cerebras, Ollama http://localhost:11434/v1 ...)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# Danh sách model, phân cách dấu phẩy: model đầu bị rate limit (429) thì tự đổi model kế tiếp
# LLM_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
